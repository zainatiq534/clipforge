PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
FIREBASE_PROJECT_ID=clipforge-8a74e

# Preferred: path to the downloaded service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Or use inline credentials instead of a JSON file:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@clipforge-8a74e.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (Dashboard → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AgentRouter (OpenAI-compatible) — viral clip AI
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_MODEL=deepseek-v4-flash
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1

# Captions via OpenRouter Whisper (same path as Lykhaari)
# CAPTIONS_PROVIDER: openrouter | local | groq
CAPTIONS_PROVIDER=openrouter
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_API_MODEL=openai/whisper-1
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=ClipForge

# Optional local Whisper fallback
# LOCAL_WHISPER_MODEL=Xenova/whisper-base.en
# LOCAL_WHISPER_QUANTIZED=true

# Optional Groq fallback — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3

# Paddle Billing (Creator / Studio)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREATOR=pri_01m8ee8xeby9jsfacn088y2jw2
PADDLE_PRICE_STUDIO=pri_01m8eeerccdbmthwg4dv3zrb73
